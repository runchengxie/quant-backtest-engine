---
import '../styles/site.css';
import {base,home,route} from '../lib/routes';
import {catalog,manifestHash} from '../lib/data';
const {locale='en',title,counterpart}=Astro.props;const c=catalog(locale);
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="color-scheme" content="light dark"/><meta name="learning-manifest" content={manifestHash}/><title>{title} · quant-backtest-engine</title><link rel="alternate" hreflang={locale==='en'?'zh-CN':'en'} href={counterpart}/></head><body><a class="learning-skip" href="#product-main">{locale==='en'?'Skip to content':'跳到正文'}</a><header class="learning-header"><a class="learning-brand" href={home(locale)}>quant-backtest-engine</a><nav aria-label={locale==='en'?'Main':'主导航'}><a data-site-nav href={route('learn',locale)}>{c['learning.learn']}</a><a data-site-nav href={route('reference',locale)}>{c['learning.reference']}</a><a data-site-locale={locale==='en'?'zh-CN':'en'} href={counterpart}>{locale==='en'?'简体中文':'English'}</a><button id="product-theme" aria-label={c['learning.theme']}>{c['learning.theme']}</button></nav></header><main id="product-main"><slot/></main><footer><p>{c['learning.synthetic']}</p><a href={base+'assets/learning/manifest.json'}>manifest.json</a> · <a href="https://github.com/runchengxie/quant-backtest-engine/pull/19">PR 19</a></footer><script is:inline src={base+'javascripts/site-locale.js'}></script><script is:inline>document.querySelector('#product-theme')?.addEventListener('click',()=>{document.documentElement.dataset.theme=document.documentElement.dataset.theme==='dark'?'light':'dark';});</script></body></html>
