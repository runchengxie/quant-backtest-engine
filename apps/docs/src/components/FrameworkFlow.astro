---
import FrameworkAnimation from './FrameworkAnimation';
import {editorial} from '../lib/editorial';
const locale=Astro.props.locale ?? 'en';const e=editorial(locale);
---
<section class="framework-flow" aria-labelledby="framework-heading">
<h2 id="framework-heading">{e['framework.title']}</h2>
<FrameworkAnimation client:load locale={locale}/><p class="event-note">{e['framework.note']}</p>
</section>
